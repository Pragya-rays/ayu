# Copy to .env (never commit .env). Keys stay server-side only.

# Gnani API key from https://app.gnani.ai/voice/ (one key covers Prisma and Timbre)
GNANI_API_KEY=

# auto = real Gnani when GNANI_API_KEY is set, otherwise mocks. mock | real force a mode.
VOICE_MODE=auto

# Prisma (STT). Models: prisma-v3.0 | prisma-v2.5. Formats: verbatim | transcribe | codemix (v3.0 only)
PRISMA_MODEL=prisma-v3.0
PRISMA_FORMAT=codemix
# Comma-separated Latin-script terms Prisma should favour (v3.0)
PRISMA_KEYTERMS=ambulance,CPR,petrol pump,Gomti Nagar,chowk,gali,hospital
# Silence that closes an utterance. Dev Guide range: 700-900
PRISMA_MIN_SILENCE_MS=800

# Timbre (TTS). timbre-v2.5 is required for Hinglish (hi-en); v3.0 has no Hinglish
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE_HI=Yashvi
TIMBRE_VOICE_HINGLISH=Poorvi
TIMBRE_VOICE_EN=Kaveri
# 0.85 - 1.15
TIMBRE_SPEED=1.0

# Gemini (extraction only; never writes medical text). Without a key, Ayu runs on rules alone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Simulated dispatch. No real ambulance is ever contacted.
# Seconds before a request counts as unacknowledged and Ayu says to call 112
ACK_TIMEOUT_SECONDS=60
# Auto-accept after this many seconds. 0 means only the dashboard can accept
AUTO_ACK_SECONDS=0
# Real seconds per simulated minute, so demos need not wait out a full ETA
SIM_MINUTE_SECONDS=15

# Area names from OpenStreetMap Nominatim. Set to off to disable (see PLAN.md for usage policy)
GEOCODER=nominatim

# Credit guards
VOICE_MAX_SESSIONS=3
VOICE_SESSION_MAX_SECONDS=600
SOS_SESSION_MAX_SECONDS=1800
# Voice Check page. Defaults to on in development, off in production. Keep off on public links.
# VOICE_LAB=true

# Password for /dashboard. Required in production. Development default: ayu-dev
# DASHBOARD_SECRET=

PORT=8787
